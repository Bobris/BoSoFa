<Project>
  <PropertyGroup>
    <BtdbVersion>36.4.0</BtdbVersion>
    <AspNetCoreVersion>10.0.14</AspNetCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BTDB" Version="$(BtdbVersion)" />
    <PackageVersion Include="BTDB.SourceGenerator" Version="$(BtdbVersion)" />
    <PackageVersion Include="BTDB.Replication" Version="$(BtdbVersion)" />
    <PackageVersion Include="BTDB.Replication.Http" Version="$(BtdbVersion)" />
    <PackageVersion Include="BTDB.Replication.Azure" Version="$(BtdbVersion)" />
    <PackageVersion Include="BTDB.Replication.EventSourcing" Version="$(BtdbVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
