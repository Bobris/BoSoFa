<Project>
  <PropertyGroup>
    <BtdbVersion>36.5.2</BtdbVersion>
    <AspNetCoreVersion>10.0.14</AspNetCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BTDB" Version="$(BtdbVersion)" />
    <PackageVersion Include="BTDB.SourceGenerator" Version="$(BtdbVersion)" />
    <PackageVersion Include="BTDB.Replication" Version="$(BtdbVersion)" />
    <PackageVersion Include="BTDB.Replication.Http" Version="$(BtdbVersion)" />
    <PackageVersion Include="BTDB.Replication.Azure" Version="$(BtdbVersion)" />
    <PackageVersion Include="BTDB.Replication.EventSourcing" Version="$(BtdbVersion)" />
    <PackageVersion Include="BTDB.BackendActions" Version="$(BtdbVersion)" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.5" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.5" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="NeoAstra" Version="1.12.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
