<Project>
  <!-- The default brand. A brand names what people see: binaries, apps, folders, services (docs/branding.md). -->
  <PropertyGroup>
    <BrandName>BoSoFa</BrandName>
    <BrandFullName>Bobris Software Factory</BrandFullName>
    <BrandId>bosofa</BrandId>
    <BrandDaemon>bosofad</BrandDaemon>
    <!-- The app and web icons (brands/icons/README.md); a brand may bring its own folder. -->
    <BrandIcons Condition="'$(BrandIcons)' == ''">$(MSBuildThisFileDirectory)icons/</BrandIcons>
  </PropertyGroup>
</Project>
