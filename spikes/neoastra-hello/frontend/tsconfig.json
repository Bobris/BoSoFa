{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "#neoastra": ["../obj/neoastra/neoastra.ts"],
      "@neoastra/client": ["./node_modules/@neoastra/client/dist/index.d.ts"]
    }
  },
  "include": ["src"]
}
