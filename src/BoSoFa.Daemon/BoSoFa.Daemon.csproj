<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The per-machine daemon (bosofad, or the brand's name) that runs agent harnesses for the server.</Description>
    <OutputType>Exe</OutputType>
    <AssemblyName>$(BrandDaemon)</AssemblyName>
    <RootNamespace>BoSoFa.Daemon</RootNamespace>
    <!-- Published as one self-contained, trimmed file. Not Native AOT: that cannot be built for another operating system, and the
         server's publish builds the daemon for every platform it hands out (plan §5.7). The code stays AOT-compatible. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(_IsPublishing)' == 'true'">none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BoSoFa.Protocol/BoSoFa.Protocol.csproj" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
</Project>
