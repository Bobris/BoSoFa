<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The per-machine daemon (bosofad, or the brand's name) that runs agent harnesses for the server.</Description>
    <OutputType>Exe</OutputType>
    <AssemblyName>$(BrandDaemon)</AssemblyName>
    <RootNamespace>BoSoFa.Daemon</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StripSymbols>true</StripSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="'$(BoSoFaReleasePublicKey)' != ''">
    <!-- The key that signs releases; a build without one refuses every update. -->
    <AssemblyMetadata Include="BoSoFaReleasePublicKey" Value="$(BoSoFaReleasePublicKey)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BoSoFa.Protocol/BoSoFa.Protocol.csproj" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
</Project>
