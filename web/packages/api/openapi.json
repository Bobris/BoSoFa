{
  "openapi": "3.1.1",
  "info": {
    "title": "testhost | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/providers": {
      "get": {
        "tags": [
          "testhost"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthProviders"
                }
              }
            }
          }
        }
      }
    },
    "/auth/dev-login": {
      "post": {
        "tags": [
          "testhost"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "testhost"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "testhost"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "testhost"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": [
          "testhost"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserDto"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthProviders": {
        "required": [
          "oidc",
          "devLogin"
        ],
        "type": "object",
        "properties": {
          "oidc": {
            "type": [
              "null",
              "string"
            ]
          },
          "devLogin": {
            "type": "boolean"
          }
        }
      },
      "DevLoginRequest": {
        "required": [
          "email",
          "name"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UserDto": {
        "required": [
          "id",
          "name",
          "email",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint64"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          }
        }
      },
      "UserRole": {
        "enum": [
          "Member",
          "Admin"
        ]
      },
      "VersionInfo": {
        "required": [
          "component",
          "version",
          "protocolVersion"
        ],
        "type": "object",
        "properties": {
          "component": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "protocolVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "testhost"
    }
  ]
}
