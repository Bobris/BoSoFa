{
  "openapi": "3.1.1",
  "info": {
    "title": "testhost | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/providers": {
      "get": {
        "tags": [
          "testhost"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthProviders"
                }
              }
            }
          }
        }
      }
    },
    "/auth/dev-login": {
      "post": {
        "tags": [
          "testhost"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "testhost"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "testhost"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "testhost"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": [
          "testhost"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/daemon/v1/enroll/start": {
      "post": {
        "tags": [
          "MachineEndpoints"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollStartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollStartResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/daemon/v1/enroll/poll": {
      "post": {
        "tags": [
          "MachineEndpoints"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollPollRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollPollResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/daemon/v1/token": {
      "post": {
        "tags": [
          "MachineEndpoints"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DaemonTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DaemonTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/daemon/v1/machine": {
      "get": {
        "tags": [
          "MachineEndpoints"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MachineDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/enrollments/{userCode}": {
      "get": {
        "tags": [
          "MachineEndpoints"
        ],
        "parameters": [
          {
            "name": "userCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/enrollments/{userCode}/approve": {
      "post": {
        "tags": [
          "MachineEndpoints"
        ],
        "parameters": [
          {
            "name": "userCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MachineDto"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/machines": {
      "get": {
        "tags": [
          "MachineEndpoints"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MachineDto"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthProviders": {
        "required": [
          "oidc",
          "devLogin"
        ],
        "type": "object",
        "properties": {
          "oidc": {
            "type": [
              "null",
              "string"
            ]
          },
          "devLogin": {
            "type": "boolean"
          }
        }
      },
      "DaemonTokenRequest": {
        "required": [
          "machineId",
          "timestamp",
          "nonce",
          "signature"
        ],
        "type": "object",
        "properties": {
          "machineId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint64"
          },
          "timestamp": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "nonce": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      },
      "DaemonTokenResponse": {
        "required": [
          "accessToken",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DevLoginRequest": {
        "required": [
          "email",
          "name"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EnrollmentDto": {
        "required": [
          "userCode",
          "name",
          "os",
          "arch",
          "daemonVersion",
          "expiresAt",
          "status"
        ],
        "type": "object",
        "properties": {
          "userCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "daemonVersion": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/EnrollStatus"
          }
        }
      },
      "EnrollPollRequest": {
        "required": [
          "enrollmentId"
        ],
        "type": "object",
        "properties": {
          "enrollmentId": {
            "type": "string"
          }
        }
      },
      "EnrollPollResponse": {
        "required": [
          "status",
          "machineId"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/EnrollStatus"
          },
          "machineId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "uint64"
          }
        }
      },
      "EnrollStartRequest": {
        "required": [
          "name",
          "os",
          "arch",
          "daemonVersion",
          "publicKey"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "daemonVersion": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          }
        }
      },
      "EnrollStartResponse": {
        "required": [
          "enrollmentId",
          "userCode",
          "verificationUri",
          "expiresAt",
          "pollIntervalSeconds"
        ],
        "type": "object",
        "properties": {
          "enrollmentId": {
            "type": "string"
          },
          "userCode": {
            "type": "string"
          },
          "verificationUri": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "pollIntervalSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "EnrollStatus": {
        "enum": [
          "Pending",
          "Approved",
          "Expired"
        ]
      },
      "MachineDto": {
        "required": [
          "id",
          "name",
          "os",
          "arch",
          "ownerId",
          "ownerName",
          "daemonVersion",
          "online",
          "connectedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint64"
          },
          "name": {
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "ownerId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint64"
          },
          "ownerName": {
            "type": "string"
          },
          "daemonVersion": {
            "type": "string"
          },
          "online": {
            "type": "boolean"
          },
          "connectedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "UserDto": {
        "required": [
          "id",
          "name",
          "email",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint64"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          }
        }
      },
      "UserRole": {
        "enum": [
          "Member",
          "Admin"
        ]
      },
      "VersionInfo": {
        "required": [
          "component",
          "version",
          "protocolVersion"
        ],
        "type": "object",
        "properties": {
          "component": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "protocolVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "testhost"
    },
    {
      "name": "MachineEndpoints"
    }
  ]
}
