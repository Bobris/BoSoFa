  "components": {
    "schemas": {
      "AnswerRuntimeRequest": {
        "required": [
          "allow",
          "message"
        ],
        "type": "object",
        "properties": {
          "allow": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AuthProviders": {
        "required": [
          "oidc",
          "devLogin"
        ],
        "type": "object",
        "properties": {
          "oidc": {
            "type": [
              "null",
              "string"
            ]
          },
          "devLogin": {
            "type": "boolean"
          }
        }
      },
      "CreateSessionRequest": {
        "required": [
          "machineId",
          "harness",
          "workingDirectory",
          "prompt",
          "permissionMode",
          "model"
        ],
        "type": "object",
        "properties": {
          "machineId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint64"
          },
          "harness": {
            "type": "string"
          },
          "workingDirectory": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "permissionMode": {
            "type": [
              "null",
              "string"
            ]
          },
          "model": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DaemonTokenRequest": {
        "required": [
          "machineId",
          "timestamp",
          "nonce",
          "signature"
        ],
        "type": "object",
        "properties": {
          "machineId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint64"
          },
          "timestamp": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "nonce": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      },
      "DaemonTokenResponse": {
        "required": [
          "accessToken",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DevLoginRequest": {
        "required": [
          "email",
          "name"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EnrollmentDto": {
        "required": [
          "userCode",
          "name",
          "os",
          "arch",
          "daemonVersion",
          "expiresAt",
          "status"
        ],
        "type": "object",
        "properties": {
          "userCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "daemonVersion": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/EnrollStatus"
          }
        }
      },
      "EnrollPollRequest": {
        "required": [
          "enrollmentId"
        ],
        "type": "object",
        "properties": {
          "enrollmentId": {
            "type": "string"
          }
        }
      },
      "EnrollPollResponse": {
        "required": [
          "status",
          "machineId"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/EnrollStatus"
          },
          "machineId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "uint64"
          }
        }
      },
      "EnrollStartRequest": {
        "required": [
          "name",
          "os",
          "arch",
          "daemonVersion",
          "publicKey"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "daemonVersion": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          }
        }
      },
      "EnrollStartResponse": {
        "required": [
          "enrollmentId",
          "userCode",
          "verificationUri",
          "expiresAt",
          "pollIntervalSeconds"
        ],
        "type": "object",
        "properties": {
          "enrollmentId": {
            "type": "string"
          },
          "userCode": {
            "type": "string"
          },
          "verificationUri": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "pollIntervalSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "EnrollStatus": {
        "enum": [
          "Pending",
          "Approved",
          "Expired"
        ]
      },
      "LiveClientMessage": {
        "required": [
          "t"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/LiveClientMessageLiveSubscribe"
          },
          {
            "$ref": "#/components/schemas/LiveClientMessageLiveUnsubscribe"
          }
        ],
        "discriminator": {
          "propertyName": "t",
          "mapping": {
            "subscribe": "#/components/schemas/LiveClientMessageLiveSubscribe",
            "unsubscribe": "#/components/schemas/LiveClientMessageLiveUnsubscribe"
          }
        }
      },
      "LiveClientMessageLiveSubscribe": {
        "required": [
          "sessionId",
          "afterSeq"
        ],
        "properties": {
          "t": {
            "enum": [
              "subscribe"
            ],
            "type": "string"
          },
          "sessionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint64"
          },
          "afterSeq": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "LiveClientMessageLiveUnsubscribe": {
        "required": [
          "sessionId"
        ],
        "properties": {
          "t": {
            "enum": [
              "unsubscribe"
            ],
            "type": "string"
          },
          "sessionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint64"
          }
        }
      },
      "LiveServerMessage": {
        "required": [
          "t"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/LiveServerMessageLiveSessionUpdate"
          },
          {
            "$ref": "#/components/schemas/LiveServerMessageLiveDelta"
          },
          {
            "$ref": "#/components/schemas/LiveServerMessageLiveError"
          }
        ],
        "discriminator": {
          "propertyName": "t",
          "mapping": {
            "session": "#/components/schemas/LiveServerMessageLiveSessionUpdate",
            "delta": "#/components/schemas/LiveServerMessageLiveDelta",
            "error": "#/components/schemas/LiveServerMessageLiveError"
          }
        }
      },
      "LiveServerMessageLiveDelta": {
        "required": [
          "sessionId",
          "ref",
          "text"
        ],
        "properties": {
          "t": {
            "enum": [
              "delta"
            ],
            "type": "string"
          },
          "sessionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint64"
          },
          "ref": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "LiveServerMessageLiveError": {
        "required": [
          "sessionId",
          "message"
        ],
